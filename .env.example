# Paper2Run Environment Configuration
# Add one or more keys to enable live extraction on uploaded PDFs.
# If no key is configured, Paper2Run operates in transparent Demo/Offline Mode.

GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Provider preference: auto | gemini | openai | anthropic
LLM_PROVIDER=auto
